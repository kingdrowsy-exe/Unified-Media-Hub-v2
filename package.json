{
  "name": "unified-media-hub-app",
  "private": true,
  "version": "2.0.0",
  "description": "Installable Windows desktop app wrapping Unified Media Hub",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix web",
    "test": "npm test --prefix server",
    "build:server": "npm run build --prefix server",
    "build:web": "npm run build --prefix web",
    "build": "npm run build:server && npm run build:web",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.6",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "undici": "^6.20.1"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kingdrowsy.unifiedmediahub",
    "productName": "Unified Media Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/dist/**/*",
      "server/package.json",
      "web/dist/**/*"
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": "nsis",
      "signingHashAlgorithms": ["sha256"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron@44.9.2": true
  }
}
